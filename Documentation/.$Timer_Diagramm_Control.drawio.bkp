        <mxCell id="naUJ_MfWsqiGFOUmN42O-38" parent="naUJ_MfWsqiGFOUmN42O-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Timer Register" vertex="1">
